{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.lunavale38.com"
        }
      ],
      "destination": "https://lunavale38.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/clarity",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 14 * * 5"
    },
    {
      "path": "/api/cron/finish-account",
      "schedule": "20 * * * *"
    }
  ]
}
